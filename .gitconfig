[alias]
	a = add
	aa = add --all
	amend = commit --amend --reset-author
	b = branch
	bd = branch -d
	bdf = branch -D
	bm = branch -m
	bn = checkout -b
	br = branch -r
	c = commit
	cl = clone
	cm = commit -m
	cma = commit -am
	co = checkout
	cp = cherry-pick
	d = diff
	dc = diff --cached
	f = fetch --all --prune
	hx = !hx
	l = log
	lo = log --oneline
	m = merge
	p = push
	pf = push --force
	pt = push --tags
	pu = pull
	pur = pull --rebase
	r = !rm -rf
	ra = rebase --abort
	rc = rebase --continue
	ri = rebase --interactive
	rir = rebase --interactive --root
	s = status
	st = stash
	sta = stash apply
	stl = stash list
	stp = stash pop
	sts = stash save
	td = tag -d
	to = !touch
	undo = reset --soft @~1
	upstream = branch --set-upstream-to=origin/main main
	vi = !vim
[include]
	path = ~/.gituser
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
