# Helix
export EDITOR=hx

# CMake
export PATH=/Applications/CMake.app/Contents/bin:$PATH
# Python
export PATH=/Users/lukaszwieczorek/Library/Python/3.9/bin:$PATH
# opt
export PATH=/opt/bin:$PATH
# local
export PATH=~/.local/bin:$PATH

# Fish
export PATH=/Applications/fish.app/Contents/Resources/base/usr/local/bin:$PATH

# Rust
. "$HOME/.cargo/env"

# Setting PATH for Python 3.14
# The original version is saved in .zprofile.pysave
PATH="/Library/Frameworks/Python.framework/Versions/3.14/bin:${PATH}"
export PATH

# Setting PATH for Python 3.15
# The original version is saved in .zprofile.pysave
PATH="/Library/Frameworks/Python.framework/Versions/3.15/bin:${PATH}"
export PATH
